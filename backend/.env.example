# ============================================================
# 网络检索 Agent - 环境变量模板
# 复制为 .env 后填写。未填写的源会自动降级（mock / 跳过）。
# ============================================================

# ---------- 大模型（必填）----------
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# 复杂推理可切换为 deepseek-reasoner
DEEPSEEK_REASONER_MODEL=deepseek-reasoner

# ---------- 服务 ----------
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001,http://localhost:5173,http://127.0.0.1:5173

# ---------- 检索行为 ----------
MAX_CONCURRENCY=6               # 并发爬虫数
SOURCE_TIMEOUT=20               # 单源超时（秒）
MAX_RESULTS_PER_SOURCE=8        # 每源最多保留条数
ENABLE_MOCK_FALLBACK=true       # 无凭证时是否用 mock 兜底（便于演示）

# ---------- 国内：Bing 中国版 ----------
# 方案A（推荐）：Azure Bing Web Search v7 官方 API
BING_SEARCH_API_KEY=
BING_SEARCH_ENDPOINT=https://api.bing.microsoft.com/v7.0/search
# 方案B：cn.bing.com HTML 抓取（无需 Key，稳定性较低）
BING_HTML_ENABLED=true

# ---------- 国外：Google 搜索 ----------
# 通过 Serper 或 SerpAPI 中转，规避验证码/人机验证
SERPER_API_KEY=
SERPAPI_API_KEY=                 # https://serpapi.com
GOOGLE_SEARCH_PROVIDER=serper    # serper | serpapi | disabled

# ---------- 国外：Nexus（Crossref 学术/知识检索）----------
# Nexus 为可插拔适配器，默认走 Crossref 公共 API（无需 Key）
NEXUS_API_URL=https://api.crossref.org/works
NEXUS_API_KEY=
NEXUS_MAILTO=your_email@example.com   # 建议填写，进入 Crossref polite pool

# ---------- 开源代码：GitHub ----------
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com

# ---------- 学术补充 ----------
ARXIV_ENABLED=true
ARXIV_API_URL=http://export.arxiv.org/api/query

# ---------- 国内社媒：MediaCrawler ----------
# MediaCrawler 需单独部署：https://github.com/NanmiCoder/MediaCrawler
MEDIACRAWLER_ENABLED=true
MEDIACRAWLER_MODE=local          # local=调用本地 MediaCrawler 目录 | remote=调用其 HTTP 服务
MEDIACRAWLER_HOME=D:/MediaCrawler
MEDIACRAWLER_PYTHON=D:/MediaCrawler/.venv/Scripts/python.exe
MEDIACRAWLER_SERVICE_URL=http://127.0.0.1:9000
# 平台代码（MediaCrawler PlatformEnum）：xhs 小红书 | dy 抖音 | ks 快手 | bili B站 | wb 微博 | tieba 贴吧 | zhihu 知乎
MEDIACRAWLER_PLATFORMS=xhs,dy,ks,bili,wb,tieba,zhihu
MEDIACRAWLER_TIMEOUT=180         # 单平台子进程超时（秒）；社媒爬取较慢，建议 ≥120
MEDIACRAWLER_SAVE_PATH=          # 留空则用 MediaCrawler 默认的 data/ 目录

# Cookie：两种写法任选（后者优先级更高）
# 1) 统一变量，多个平台用分号分隔：MEDIACRAWLER_COOKIES=xhs=abc;wb=def;bili=ghi
# 2) 独立变量：MEDIACRAWLER_COOKIE_XHS=... / _DY / _KS / _BILI / _WB / _TIEBA / _ZHIHU
# 缺失 Cookie 的平台会返回明确提示而不阻塞整体流程
MEDIACRAWLER_COOKIES=
MEDIACRAWLER_COOKIE_XHS=
MEDIACRAWLER_COOKIE_DY=
MEDIACRAWLER_COOKIE_KS=
MEDIACRAWLER_COOKIE_BILI=
MEDIACRAWLER_COOKIE_WB=
MEDIACRAWLER_COOKIE_TIEBA=
MEDIACRAWLER_COOKIE_ZHIHU=

# ---------- 国内社媒：小黑盒（xiaoheihe.cn）----------
# 已内置完整 hkey/_time/nonce 签名算法（与网页端逐位对齐验证）。
# 接口同时校验登录态，因此提供两种模式：
#   browser（默认，推荐）：用 Playwright 打开页面在浏览器上下文内请求，
#                          自动携带 Cookie 与真实环境。首次运行会打开窗口，扫码登录一次即可，
#                          登录态持久化在 XIAOHEIHE_USER_DATA_DIR。
#   api    （轻量）      ：httpx 直连，需手工把网页版 Cookie 粘到 XIAOHEIHE_COOKIE。
XIAOHEIHE_ENABLED=true
XIAOHEIHE_MODE=browser
XIAOHEIHE_COOKIE=
XIAOHEIHE_HEADLESS=true          # 首次登录建议改 false，扫码完成后可改回 true
XIAOHEIHE_TIMEOUT=60
XIAOHEIHE_USER_DATA_DIR=backend/.cache/xiaoheihe-profile

# ---------- 招聘：BOSS 直聘（zhipin.com）----------
# 直接用内部职位 API（/wapi/zpgeek/search/joblist.json），其 salaryDesc 为明文薪资，
# 无需解析前端动态字体。接口有 Cookie + __zp_stoken__ 风控校验，故同样提供两种模式：
#   browser（默认，推荐）：Playwright 打开搜索页后在页面内 fetch，自动带 Cookie/stoken。
#                          首次运行会开窗口，扫码登录一次，登录态持久化在 BOSS_USER_DATA_DIR。
#   api    （轻量）      ：httpx 直连，需手工粘贴含 __zp_stoken__ 的完整 Cookie。
BOSS_ENABLED=true
BOSS_MODE=browser
BOSS_COOKIE=
BOSS_CITY=                       # 可填城市名（北京/上海/深圳…）或 9 位城市代码；留空=全国
BOSS_HEADLESS=true               # 首次登录建议改 false
BOSS_TIMEOUT=60
BOSS_USER_DATA_DIR=backend/.cache/boss-profile
